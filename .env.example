# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored and must never be committed.
# In CI/production, these are provided by the hosting/deploy platform instead of a file.

# --- PostgreSQL (used by compose.yaml to initialize the container, and by
# --- DATABASE_URL below to connect to it) ---
POSTGRES_USER=myapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myapp_dev

# --- Prisma / application database connection ---
# Must stay in sync with the POSTGRES_* values above for local development.
DATABASE_URL="postgresql://myapp:changeme@localhost:5432/myapp_dev?schema=public"

# --- Auth (Better Auth) ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme
BETTER_AUTH_URL=http://localhost:3000
